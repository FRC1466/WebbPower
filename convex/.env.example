# These are Convex deployment environment variables.
# Set them with: bunx convex env set VAR_NAME "value"
# Or via the Convex dashboard → Settings → Environment Variables.

# ─── Convex Auth ──────────────────────────────────────────────────────────────
# Required by @convex-dev/auth — set automatically when you run `bunx convex dev`
CONVEX_SITE_URL=https://YOUR_WEBBPOWER_DEPLOYMENT.convex.site
JWT_PRIVATE_KEY=        # generated by `bunx @convex-dev/auth`
JWKS=                   # generated by `bunx @convex-dev/auth`

# ─── team-1466 Integration ────────────────────────────────────────────────────
# The Convex HTTP site URL for the team-1466 dashboard deployment.
# Find it in the team-1466 Convex dashboard under Settings → URL & Deploy Key.
# It usually looks like: https://TEAM1466_DEPLOYMENT.convex.site
TEAM_DASHBOARD_URL=https://YOUR_TEAM1466_DEPLOYMENT.convex.site

# Shared secret between both apps for the /internal/member-lookup endpoint.
# Generate a random string, e.g.: openssl rand -hex 32
# Must be set to the SAME value in BOTH this deployment AND the team-1466 deployment.
TEAM_DASHBOARD_API_KEY=your-shared-secret-here
